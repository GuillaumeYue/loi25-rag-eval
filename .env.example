# Copy to .env and adjust. .env is git-ignored; never commit real keys.

# --- Database (docker-compose.yml exposes PostgreSQL on 5433) ---
POSTGRES_PASSWORD=loi25
DATABASE_URL=postgresql://loi25:loi25@localhost:5433/loi25

# --- Embeddings ---
# stub      : deterministic fake vectors, no model download. Used by unit tests.
# fastembed : local model, free, no API key.
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Generation model ---
# stub      : deterministic fake answers, no API key. Used by unit tests.
# anthropic : Claude API. Needs ANTHROPIC_API_KEY.
# ollama    : not implemented yet.
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=4096

# --- Retrieval ---
TOP_K=5

# --- Mitigations (milestone 7) ---
# Each one is off by default so baseline and mitigated runs stay comparable.
# 1/true/yes/on turns a flag on.
ENFORCE_ACCESS_CONTROL=0
ISOLATE_CONTEXT=0
TOOL_GUARD=0
OUTPUT_FILTER=0
# Recipient domains TOOL_GUARD accepts for send_email (comma-separated).
TOOL_ALLOWED_DOMAINS=energie-boreale.example
